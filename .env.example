POSTGRES_PASSWORD=postgres
DJANGO_SECRET_KEY=secret

# in case your can edit /etc/hosts:
# add this domain `rustfs.localhost` to your /etc/hosts
# otherwise, set the hostname of your computer
# this is necessary to ensure DNS resolution outside docker
# localhost would be resolved to the container internal host
# ignore this variable if you plan to use an external s3 bucket
RUSTFS_HOSTNAME=rustfs.local

# the AWS_S3_ENDPOINT must be resolvable both by your browser and docker
# if using the dev bucket (rustfs) set this to the same host as RUSTFS_HOSTNAME
AWS_S3_ENDPOINT_URL=http://rustfs.local:8000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_STORAGE_BUCKET_NAME=dms

# RSA private key (PEM) used to sign OIDC ID tokens issued by catalog's own
# /o/ endpoint when catalog acts as an OIDC *provider* (django-oauth-toolkit).
# NOT to be confused with OIDC_CLIENT_ID/OIDC_SECRET/OIDC_PROVIDER_* (set
# elsewhere, e.g. docker-compose.yml), which configure catalog as an OIDC
# *client* (django-allauth) delegating its own users' login to an external
# IdP. Leave unset to disable the provider role entirely (opt-in).
# Generate locally with:
#   openssl genrsa -out oidc.key 4096
OIDC_RSA_PRIVATE_KEY=

# Fernet key used to encrypt buckets.Storage credential fields.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_CREDENTIALS_KEY=
